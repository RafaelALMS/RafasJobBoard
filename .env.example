# ── Matching (optional) ─────────────────────────────────────────────
# Without keys the app still works: search + local keyword scoring.
# With keys you get semantic (embedding) ranking + LLM match analysis.
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, Groq, Ollama…)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Fallback key used for both LLM and embeddings if the ones above are empty
OPENAI_API_KEY=

# ── Extra job sources (optional, all free tiers) ────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
JOOBLE_API_KEY=
INFOJOBS_KEY=
INFOJOBS_SECRET=
SERPAPI_KEY=

# ── Misc ────────────────────────────────────────────────────────────
#ENABLE_MOCK=1          # offline fixtures adapter for development
PORT=3001
HOST=127.0.0.1
#SOURCE_TIMEOUT_MS=9000
